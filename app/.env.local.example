# WalletConnect project ID — get one at cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Monad testnet RPC (default: https://testnet-rpc.monad.xyz)
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# PayrollManager contract address (fill after: forge script Deploy.s.sol --broadcast)
NEXT_PUBLIC_PAYROLL_MANAGER_ADDRESS=0x

# Executor service URL
NEXT_PUBLIC_EXECUTOR_URL=http://localhost:3001
