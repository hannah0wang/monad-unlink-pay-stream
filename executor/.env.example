# Executor EOA private key — signs PayrollManager.executePay() transactions
EXECUTOR_PRIVATE_KEY=0x

# The public address derived from EXECUTOR_PRIVATE_KEY
# Used in x402 paymentRequired responses as payTo address
EXECUTOR_ADDRESS=0x

# PayrollManager contract address (from Deploy.s.sol output)
PAYROLL_MANAGER_ADDRESS=0x

# Token address — must match what was passed to PayrollManager constructor
USDC_ADDRESS=0xc4fB617E4E4CfbdEb07216dFF62B4E46a2D6FdF6

# Monad testnet RPC
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# x402 facilitator (Monad testnet)
# X402_FACILITATOR_URL=https://x402-facilitator.molandak.org

# Internal auth key — required to call POST /internal/runCycle for testing
INTERNAL_KEY=change-me-before-deploy

# Executor USDCm float — pre-fund the executor EOA with USDCm for bill payments.
# The executor fronts x402 bill payments from its EOA, then gets reimbursed from
# each employee's Utilities Unlink bucket. Without this float, bill payments fail.
#
# How to fund:
#   cast send $USDC_ADDRESS "transfer(address,uint256)" $EXECUTOR_ADDRESS 500000000 \
#     --private-key $YOUR_PRIVATE_KEY --rpc-url $MONAD_RPC_URL
#
# $500 USDCm recommended for demo (covers ~40 electric bills before reimbursements catch up)
# Monitor via: curl http://localhost:3001/health

# Employer payroll agent URL
# In production: employer runs their own payroll agent at a different address.
# In demo: same process (loops back to this server's /payroll/release-wages).
PAYROLL_AGENT_URL=http://localhost:3001

# Biller service URLs (defaults to localhost)
ELECTRIC_BILLER_URL=http://localhost:3002
INSURANCE_BILLER_URL=http://localhost:3003

# Port
PORT=3001
